# ── Modo ──────────────────────────────────────────────────────────────────────
# true  = dev local sem RDS/Databricks (usa seed/seed_data.json em memória)
# false = produção/staging (App Runner) com RDS Postgres
MOCK_MODE=true

# ── Postgres (AWS RDS / Aurora) ─────────────────────────────────────────────────
PGHOST=santander-certifica.xxxxxxxx.us-east-1.rds.amazonaws.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=certifica_app
PGSSLMODE=require
PGSCHEMA=santander_certifica
# Opção A — senha estática (injetada via AWS Secrets Manager no App Runner):
PGPASSWORD=
# Opção B — autenticação IAM (sem senha estática; a task role do App Runner gera o token):
RDS_IAM_AUTH=false
AWS_REGION=us-east-1

# ── LLM: Databricks Foundation Model API (cross-cloud) ──────────────────────────
# O LLM continua no Databricks; só os dados moram no RDS.
DATABRICKS_HOST=https://fevm-serverless-stable-cvpomp.cloud.databricks.com
# Service principal OAuth M2M (recomendado em App Runner) — NÃO use junto com DATABRICKS_TOKEN.
# O SP precisa de CAN_QUERY no endpoint de serving (databricks-claude-opus-4-8):
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Endpoint Foundation Model API — confirmado READY neste workspace (Claude Opus 4.8).
# Atenção: modelos Opus 4.x NÃO aceitam o parâmetro `temperature` (tratado no llm_gen.py).
LLM_ENDPOINT=databricks-claude-opus-4-8

# ── Auth (JWT + bcrypt) ─────────────────────────────────────────────────────────
ENABLE_JWT_AUTH=true
JWT_SECRET=troque-isto-em-producao
ADMIN_EMAIL=admin@santander.cl
ALLOW_SELF_REGISTER=true
PASS_MARK=70
PROVISIONED_USERS=
PROVISIONED_INITIAL_PASSWORD=SantanderCertifica@2026

# ── App ──────────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Origens permitidas (CORS): a URL do Amplify + dev local.
CORS_ORIGINS=https://main.xxxxxxxx.amplifyapp.com,http://localhost:5173,http://localhost:3006
